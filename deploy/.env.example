# mkEngage production environment — copy to deploy/.env and fill in.
# NEVER commit deploy/.env. Generate every secret fresh on the server:
#   APP_KEY:             echo "base64:$(openssl rand -base64 32)"
#   SECRET_KEY_BASE:     openssl rand -hex 64
#   GATEWAY_SIGNING_KEY: openssl rand -hex 32
#   AI_SERVICE_TOKEN:    openssl rand -hex 32
#   DB_PASSWORD:         openssl rand -hex 24

# ── Domains ──────────────────────────────────────────────────────────────
# DNS A records required: app.DOMAIN, api.DOMAIN, ws.DOMAIN → this server.
# LAN-only box (no public domain)? Keep placeholder values here, set
# SERVER_ADDR below, and start with the extra docker-compose.lan.yml file —
# see "LAN-only mode" in DEPLOY.md.
DOMAIN=mkengage.example.com
ACME_EMAIL=you@example.com

# LAN mode only: this machine's LAN IP or hostname (e.g. 192.168.1.50).
SERVER_ADDR=

# ── Database ─────────────────────────────────────────────────────────────
DB_DATABASE=mkengage
DB_USERNAME=mkengage
DB_PASSWORD=

# ── Secrets ──────────────────────────────────────────────────────────────
APP_KEY=
SECRET_KEY_BASE=
GATEWAY_SIGNING_KEY=
AI_SERVICE_TOKEN=

# ── Outbound email (global mailer; per-org SMTP is set per email channel) ─
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=hello@example.com

# ── AI providers (optional — set the ones you use) ───────────────────────
AI_SERVICE_GOOGLE_API_KEY=
AI_SERVICE_ANTHROPIC_API_KEY=
AI_SERVICE_OPENAI_API_KEY=
