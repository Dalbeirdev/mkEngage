# mkEngage AI service — environment (copy to `.env`, never commit the real file).
# Config is prefixed AI_SERVICE_ (see app/config.py). Keys are read here only;
# they are never logged, echoed, or placed in URLs (§18).

# Shared internal bearer the control plane uses to call this service (required).
AI_SERVICE_TOKEN=local-dev-internal-token

# --- AI provider keys (set only the one(s) you use) ---
# Google Gemini — does BOTH chat and embeddings (single-vendor RAG).
# Get one at https://aistudio.google.com/apikey  → paste it below.
AI_SERVICE_GOOGLE_API_KEY=

# OpenAI — chat + embeddings.
# AI_SERVICE_OPENAI_API_KEY=

# Anthropic (Claude) — chat only (no embeddings API).
# AI_SERVICE_ANTHROPIC_API_KEY=
